{
  "name": "convochat",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "description": "A real-time chat application built with Express.js, Socket.IO, and TypeScript",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts --exec ts-node",
    "dev-simple": "ts-node src/index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "chat",
    "socket.io",
    "express",
    "typescript",
    "real-time",
    "messaging"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
